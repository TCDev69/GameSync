<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GameSync.Core.Models">

    <Grid Padding="32">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image
                Source="ms-appx:///Assets/GameSyncLogo.png"
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                AutomationProperties.Name="GameSync logo" />
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Welcome to GameSync" HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Sync game saves through your private GitHub repository."
                TextWrapping="WrapWholeWords"
                HorizontalAlignment="Center"
                TextAlignment="Center" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                IsClosable="True" />

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Width="40"
                Height="40"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                HorizontalAlignment="Center"
                TextAlignment="Center" />

            <!-- Welcome -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsWelcome, Mode=OneWay}">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Get started"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.StartCommand}" />
            </StackPanel>

            <!-- Connect GitHub -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsConnect, Mode=OneWay}">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connect GitHub" HorizontalAlignment="Center" />
                <Button Content="Start device login" HorizontalAlignment="Center" Command="{x:Bind ViewModel.BeginDeviceFlowCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.UserCode, Mode=OneWay}"
                        Style="{StaticResource TitleTextBlockStyle}"
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True" />
                    <Button
                        Content="Copy code"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CopyUserCodeCommand}"
                        AutomationProperties.Name="Copy login code" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.VerificationUri, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" IsTextSelectionEnabled="True" />
                <Button Content="Open GitHub" HorizontalAlignment="Center" Click="OpenVerification_Click" />
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Content="I've authorized GameSync"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.CompleteDeviceFlowCommand}" />
            </StackPanel>

            <!-- Select repo -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsSelectRepo, Mode=OneWay}">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Select repository" HorizontalAlignment="Center" />
                <TextBox
                    PlaceholderText="Search repositories"
                    Text="{x:Bind ViewModel.RepositorySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Search repositories" />
                <ListView
                    Height="240"
                    ItemsSource="{x:Bind ViewModel.Repositories, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedRepository, Mode=TwoWay}"
                    AutomationProperties.Name="Repositories">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RepositoryConfiguration">
                            <TextBlock>
                                <Run Text="{x:Bind Owner}" /><Run Text="/" /><Run Text="{x:Bind Name}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshRepositoriesCommand}" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="Connect" Command="{x:Bind ViewModel.ConnectRepositoryCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Initialize -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsInitialize, Mode=OneWay}">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Initialize GameSync" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Cloning repository and preparing config/games.json…"
                    TextWrapping="WrapWholeWords"
                    HorizontalAlignment="Center"
                    TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
