<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.AddGamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameSync.App.ViewModels"
    xmlns:models="using:GameSync.Core.Models">

    <ScrollViewer
        Padding="24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="840" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Add game" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                IsClosable="True" />

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Width="40"
                Height="40"
                HorizontalAlignment="Left"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Shared" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="These values sync through your repository for every PC." />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Search / title"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="Cyberpunk 2077"
                    AutomationProperties.Name="Game search" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Fetch"
                    Command="{x:Bind ViewModel.FetchCommand}"
                    AutomationProperties.Name="Fetch game metadata" />
            </Grid>

            <ListView
                Header="Search results"
                ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="SearchResults_ItemClick"
                MaxHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameSearchResult">
                        <TextBlock Text="{x:Bind Title}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox Header="Game title" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Cover URL" Text="{x:Bind ViewModel.CoverUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Border
                Width="120"
                Height="180"
                Background="{ThemeResource CoverPlaceholderBrush}"
                HorizontalAlignment="Left">
                <Image
                    Source="{x:Bind ViewModel.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                    Stretch="UniformToFill" />
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Save locations" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.SaveLocations, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveLocationEditItem">
                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Id" Text="{x:Bind Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="1"
                                Header="Local path"
                                Text="{x:Bind LocalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Content="Browse"
                                Click="BrowseSaveFolder_Click"
                                Tag="{x:Bind}" />
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Bottom"
                                Content="Remove"
                                Click="RemoveSaveLocation_Click"
                                Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add save location" Command="{x:Bind ViewModel.AddSaveLocationCommand}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="This PC only" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Drop a .exe or .lnk shortcut, browse, paste a steam:// URI, or use Launch via Steam." />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ExecutableDropBorder"
                    Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    AllowDrop="True"
                    DragOver="ExecutableDropBorder_DragOver"
                    Drop="ExecutableDropBorder_Drop">
                    <TextBox
                        Header="Executable or Steam URI"
                        Text="{x:Bind ViewModel.Executable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="C:\Games\...\game.exe or steam://run/1091500"
                        BorderThickness="0"
                        AutomationProperties.Name="Game executable or Steam URI" />
                </Border>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse" Click="BrowseExecutable_Click" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Content="Launch via Steam"
                    Command="{x:Bind ViewModel.UseSteamLaunchCommand}"
                    Visibility="{x:Bind ViewModel.CanUseSteamLaunch, Mode=OneWay}" />
            </Grid>
            <TextBox
                Header="Monitor process (.exe, optional for Steam)"
                Text="{x:Bind ViewModel.MonitorExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Optional: game .exe used to detect when Steam session ends" />
            <TextBox Header="Arguments" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Working directory" Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
