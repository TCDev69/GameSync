<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.SteamImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameSync.App.ViewModels"
    NavigationCacheMode="Disabled">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Content="&#xE72B;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Command="{x:Bind ViewModel.GoBackCommand}"
                AutomationProperties.Name="Go back" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Import from Steam"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ProgressRing
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
            <ProgressRing
                Width="20" Height="20"
                IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- Game list -->
        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
            SelectionMode="None"
            AutomationProperties.Name="Steam games list">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SteamImportItemViewModel">
                    <Grid Padding="4,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind Title}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Text="{x:Bind Title}"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind InstallDir}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind AppId}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Border
                            Grid.Column="3"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            Padding="8,2"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind AlreadyInLibrary}">
                            <TextBlock
                                Text="Already in library"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Select all" Command="{x:Bind ViewModel.SelectAllCommand}" />
            <Button Content="Clear" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
            <Button
                Style="{StaticResource AccentButtonStyle}"
                Content="Import selected"
                Command="{x:Bind ViewModel.ImportSelectedCommand}" />
        </StackPanel>

        <!-- Duplicate dialog (overlay) -->
        <ContentDialog
            x:Name="DuplicateDialog"
            Title="Duplicate game detected"
            PrimaryButtonText="Import as new"
            SecondaryButtonText="Update launch only"
            CloseButtonText="Skip"
            DefaultButton="Primary" />
    </Grid>
</Page>
