<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.SyncStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sync status" />
            <TextBlock
                x:Name="StatusText"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Loading…"
                TextWrapping="WrapWholeWords" />
            <ProgressRing x:Name="BusyRing" Width="40" Height="40" HorizontalAlignment="Left" />
            <Button Content="Open History" Click="OpenHistory_Click" />
        </StackPanel>
    </Grid>
</Page>
