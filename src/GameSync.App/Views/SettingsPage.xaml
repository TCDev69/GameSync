<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        Padding="24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12" MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" Margin="0,0,0,4" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,4" />

            <controls:SettingsExpander Header="GitHub account" Description="{x:Bind ViewModel.GitHubAccount, Mode=OneWay}" HorizontalAlignment="Stretch">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Sign out">
                        <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="Repository" Description="{x:Bind ViewModel.Repository, Mode=OneWay}" HorizontalAlignment="Stretch">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Branch" Description="{x:Bind ViewModel.Branch, Mode=OneWay}" />
                    <controls:SettingsCard Header="Disconnect repository">
                        <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectRepositoryCommand}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard Header="Machine ID" Description="{x:Bind ViewModel.MachineId, Mode=OneWay}" HorizontalAlignment="Stretch" />

            <controls:SettingsExpander Header="Backup retention" Description="Local backups before restore and sync" HorizontalAlignment="Stretch">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Enabled">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.BackupEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Max backups per game">
                        <NumberBox
                            Value="{x:Bind ViewModel.MaxBackupsPerGame, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="100"
                            SpinButtonPlacementMode="Inline"
                            Width="120" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Save backup settings">
                        <Button Content="Save" Command="{x:Bind ViewModel.SaveBackupSettingsCommand}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="Appearance" Description="{x:Bind ViewModel.SelectedTheme, Mode=OneWay}" HorizontalAlignment="Stretch">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Theme">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="System" Command="{x:Bind ViewModel.SetThemeCommand}" CommandParameter="System" />
                            <Button Content="Light" Command="{x:Bind ViewModel.SetThemeCommand}" CommandParameter="Light" />
                            <Button Content="Dark" Command="{x:Bind ViewModel.SetThemeCommand}" CommandParameter="Dark" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="Automatic updates" Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" HorizontalAlignment="Stretch">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Check on startup" Description="Silently look for a newer release a few seconds after the app opens.">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdatesOnStartup, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Check for updates">
                        <Button Content="Check now" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Install update">
                        <StackPanel Spacing="8" MinWidth="280">
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Downloads the release installer, verifies its SHA-256 and installs it. GameSync closes and reopens; your library and saves are preserved."
                                TextWrapping="WrapWholeWords" />
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressBar
                                    Width="160"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.UpdateProgress, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay}" />
                                <Button
                                    Content="Update"
                                    Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander Header="Logging / diagnostics" Description="{x:Bind ViewModel.LogsPath, Mode=OneWay}" HorizontalAlignment="Stretch">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Open logs folder">
                        <Button Content="Open" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsCard Header="About" Description="{x:Bind ViewModel.AboutText, Mode=OneWay}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>
