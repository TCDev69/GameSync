<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.GameDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameSync.App.ViewModels">

    <ScrollViewer
        Padding="24"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="840" HorizontalAlignment="Left">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Game details" />
                <Button Grid.Column="1" Content="Sync" Command="{x:Bind ViewModel.SyncCommand}" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Content="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                <Button Grid.Column="3" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
            </Grid>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                IsClosable="True" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Left" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Shared" />
            <TextBox Header="Title" Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Cover URL" Text="{x:Bind ViewModel.CoverUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Border Width="120" Height="180" Background="{ThemeResource CoverPlaceholderBrush}" HorizontalAlignment="Left">
                <Image
                    Source="{x:Bind ViewModel.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                    Stretch="UniformToFill" />
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Save locations" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.SaveLocations, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveLocationEditItem">
                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Id" Text="{x:Bind Id, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="Local path" Text="{x:Bind LocalPath, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Header="Remote path" Text="{x:Bind RemotePath, Mode=TwoWay}" />
                            <Button Grid.Column="3" VerticalAlignment="Bottom" Content="Remove" Click="RemoveSaveLocation_Click" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add save location" Command="{x:Bind ViewModel.AddSaveLocationCommand}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="This PC only" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ExecutableDropBorder"
                    Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    AllowDrop="True"
                    DragOver="ExecutableDropBorder_DragOver"
                    Drop="ExecutableDropBorder_Drop">
                    <TextBox
                        Header="Executable or Steam URI"
                        Text="{x:Bind ViewModel.Executable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        BorderThickness="0" />
                </Border>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse" Click="BrowseExecutable_Click" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Content="Launch via Steam"
                    Command="{x:Bind ViewModel.UseSteamLaunchCommand}"
                    Visibility="{x:Bind ViewModel.CanUseSteamLaunch, Mode=OneWay}" />
            </Grid>
            <TextBox Header="Monitor process (.exe)" Text="{x:Bind ViewModel.MonitorExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Arguments" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Working directory" Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Shortcuts" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    Content="Desktop shortcut"
                    IsChecked="{x:Bind ViewModel.HasDesktopShortcut, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleDesktopShortcutCommand}" />
                <ToggleButton
                    Content="Start menu shortcut"
                    IsChecked="{x:Bind ViewModel.HasStartMenuShortcut, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleStartMenuShortcutCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
