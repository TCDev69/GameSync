<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameSync.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GameSync.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Your Games"
                AutomationProperties.HeadingLevel="Level1" />
            <Button
                Grid.Column="1"
                Content="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}"
                AutomationProperties.Name="Refresh library" />
            <Button
                Grid.Column="2"
                Content="Import from Steam"
                Command="{x:Bind ViewModel.ImportFromSteamCommand}"
                AutomationProperties.Name="Import from Steam" />
            <Button
                Grid.Column="3"
                Style="{StaticResource AccentButtonStyle}"
                Content="Add game"
                Command="{x:Bind ViewModel.AddGameCommand}"
                AutomationProperties.Name="Add game" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
            Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
            IsClosable="True" />

        <Grid Grid.Row="2">
            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading games" />

            <TextBlock
                Text="No games yet. Add a game to start syncing saves."
                Style="{StaticResource BodyTextBlockStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <GridView
                x:Name="GamesGrid"
                ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="GamesGrid_ItemClick"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                AutomationProperties.Name="Game library">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="176" ItemHeight="300" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardItem">
                        <Border
                            Width="160"
                            Margin="4"
                            Background="{ThemeResource GameCardBackgroundBrush}"
                            BorderBrush="{ThemeResource GameCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            AutomationProperties.Name="{x:Bind Title}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="240" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Background="{ThemeResource CoverPlaceholderBrush}">
                                    <Image
                                        Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill"
                                        Visibility="{x:Bind HasCover}" />
                                    <FontIcon
                                        Glyph="&#xE7FC;"
                                        FontSize="32"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind HasCover, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <Border
                                        Background="{ThemeResource StatusWarningBrush}"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="{x:Bind HasWarning}">
                                        <TextBlock Text="!" FontSize="12" Foreground="White" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Padding="10,8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            ToolTipService.ToolTip="{x:Bind Title}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Fill="{x:Bind Status, Converter={StaticResource StatusToBrush}}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind StatusText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        Command="{x:Bind OpenDetailsCommand}"
                                        ToolTipService.ToolTip="Game details"
                                        AutomationProperties.Name="Open game details">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
