<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GameCardBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="GameCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="StatusSyncedBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StatusLocalBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="StatusRemoteBrush" Color="#881798" />
            <SolidColorBrush x:Key="StatusConflictBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusSyncingBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="StatusMutedBrush" Color="#8A8886" />
            <SolidColorBrush x:Key="StatusRunningBrush" Color="#0099BC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GameCardBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="GameCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="StatusSyncedBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="StatusLocalBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="StatusRemoteBrush" Color="#881798" />
            <SolidColorBrush x:Key="StatusConflictBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="StatusSyncingBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="StatusMutedBrush" Color="#605E5C" />
            <SolidColorBrush x:Key="StatusRunningBrush" Color="#0099BC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GameCardBackgroundBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="GameCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="StatusSyncedBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="StatusLocalBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="StatusRemoteBrush" Color="#D59DFF" />
            <SolidColorBrush x:Key="StatusConflictBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="StatusSyncingBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="StatusMutedBrush" Color="#A19F9D" />
            <SolidColorBrush x:Key="StatusRunningBrush" Color="#61D6D6" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
