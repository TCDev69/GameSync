<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GameSync.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GameSync.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/SemanticColors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
            <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
            <converters:GameLibraryStatusToTextConverter x:Key="StatusToText" />
            <converters:GameLibraryStatusToBrushConverter x:Key="StatusToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
